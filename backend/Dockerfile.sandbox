FROM python:3.12-slim

ENV HOME=/tmp \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MPLCONFIGDIR=/tmp/mpl

WORKDIR /opt/sandbox
COPY --chmod=0444 src/services/sandbox_runner.py /opt/sandbox/sandbox_runner.py

USER 65534:65534

ENTRYPOINT ["python", "-I", "-B", "-u", "/opt/sandbox/sandbox_runner.py"]
