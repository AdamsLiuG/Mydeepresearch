# DeepResearch Agent backend configuration example
# Copy this file to backend/.env and edit backend/.env as the real config entry.

# Search backend: duckduckgo, tavily, perplexity, searxng, semanticscholar, advanced
SEARCH_API=duckduckgo

# LLM provider
# Options: ollama, lmstudio, custom
LLM_PROVIDER=custom
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-api-base-url

# Runtime
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Agent loop and search behavior
MAX_WEB_RESEARCH_LOOPS=3
MAX_AGENT_TASKS=5
USE_TOOL_CALLING=True
TASK_QUERY_REWRITE_ENABLED=True
TASK_REACT_ENABLED=True
TASK_REACT_MAX_ROUNDS=2
TASK_REACT_MAX_FETCHES_PER_TASK=2
TASK_REACT_MAX_ADDITIONAL_SEARCHES_PER_TASK=1
REQUEST_REFLECTION_ENABLED=True
REFLECTION_MAX_ADDITIONAL_TASKS=2
REVIEW_STAGE_ENABLED=True
REVIEW_AGENT_ENABLED=True
REVIEW_MIN_SOURCES_PER_TASK=2
REVIEW_MIN_DOMAINS_PER_TASK=2
REPORT_REPAIR_ENABLED=True
REPORT_REPAIR_MAX_TASKS=2
REPORT_REPAIR_MAX_CYCLES=1
FRESHNESS_REFERENCE_DAYS=365
SEARCH_TOOL_TIMEOUT_SECONDS=8
SEARCH_TOOL_RETRY_ATTEMPTS=1
SEARCH_TOOL_RETRY_BACKOFF_SECONDS=0
FETCH_FULL_PAGE=True
ENABLE_NOTES=True
NOTES_WORKSPACE=./notes
NOTE_MEMORY_ENABLED=False
NOTE_MEMORY_DIR=./.memory/notes
NOTE_MEMORY_EMBEDDING_MODEL=
NOTE_MEMORY_PLANNING_TOP_K=3
NOTE_MEMORY_EXECUTION_TOP_K=3
NOTE_MEMORY_PROMPT_CHAR_LIMIT=1800
STRATEGY_MEMORY_ENABLED=False
STRATEGY_MEMORY_DIR=./.memory/strategies
STRATEGY_MEMORY_EMBEDDING_MODEL=
STRATEGY_MEMORY_PLANNING_TOP_K=3
STRATEGY_MEMORY_REFLECTION_TOP_K=3
STRATEGY_MEMORY_PROMPT_CHAR_LIMIT=1600

# Search cache
SEARCH_CACHE_ENABLED=True
SEARCH_CACHE_DYNAMIC_TTL_ENABLED=True
SEARCH_CACHE_TTL_SECONDS=43200
SEARCH_CACHE_FRESH_TTL_SECONDS=14400
SEARCH_CACHE_EVERGREEN_TTL_SECONDS=172800
SEARCH_CACHE_DIR=./.cache/search
SEARCH_CACHE_VECTOR_DIR=./.cache/search/vector

# Semantic cache
SEMANTIC_CACHE_ENABLED=True
SEMANTIC_CACHE_WARMUP_ENABLED=True
SEMANTIC_CACHE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
SEMANTIC_CACHE_LEXICAL_THRESHOLD=0.35

# Metrics
METRICS_RECENT_REQUESTS_LIMIT=25

# Request state persistence / resume
REQUEST_STATE_ENABLED=True
REQUEST_STATE_DIR=./.state/requests
REQUEST_STATE_RECENT_LIMIT=50

# Perf / benchmark
BENCHMARK_STUB_ENABLED=False
BENCHMARK_PROFILE=real_local
PERF_SAMPLE_INTERVAL_SECONDS=0.5
# PERF_THRESHOLDS_PATH=./perf/baselines/stub_baseline.json

# Pricing catalog used by /metrics/json estimated_cost
# LLM_PRICING_JSON={"custom":{"your-model-name":{"prompt_per_1k_tokens":0.001,"completion_per_1k_tokens":0.002}}}

# Search provider credentials
# TAVILY_API_KEY=tvly-xxxxx
# PERPLEXITY_API_KEY=pplx-xxxxx
# SEARXNG_URL=http://localhost:8888
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key

# Local model endpoints
# LOCAL_LLM=qwen_qwq-32b
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434
